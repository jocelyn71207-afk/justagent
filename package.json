{
  "name": "JustAgent-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "built-type-check-sit": "run-p type-check \"sit {@}\" --",
    "sit": "vite build --mode sit",
    "built-type-check-uat": "run-p type-check \"uat {@}\" --",
    "uat": "vite build --mode uat",
    "built-type-check-biz": "run-p type-check \"biz {@}\" --",
    "biz": "vite build --mode biz",
    "built-type-check": "run-p type-check \"build {@}\" --",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@gausszhou/vue3-drag-resize-rotate": "^3.0.2",
    "@wolf-table/table": "^0.0.1",
    "axios": "^1.12.2",
    "chart.js": "^4.5.0",
    "floating-vue": "^5.2.2",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "js-cookie": "^3.0.5",
    "katex": "^0.16.27",
    "konva": "^10.0.2",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-katex": "^2.0.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-sweetalert2": "^5.0.11",
    "vue3-drag-resize": "^2.0.5",
    "vue3-tooltip": "^2.3.0",
    "vue3-virtual-scroll-list": "^0.2.1",
    "x-data-spreadsheet": "^1.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "sass": "^1.92.1",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
